#!/bin/sh /etc/rc.common
# buffy-credentials - 每次开机把 OpenClash 当前生效的控制台/API 凭据快照到文本文件
#
# 为什么不做在 /etc/rc.local 里（2026-09-29 实证）：
#   /etc/rc.local 位于 /lib/upgrade/keep.d/base-files-essential（该文件头注释为
#   "Essential files that will be always kept"），sysupgrade 会**永久保留**它 ——
#   实机 /etc/rc.local 停在上一版固件：mtime Sep 7 13:10、3633 B、不含 export_credentials
#   调用；而 /rom/etc/rc.local 是新版 Sep 27 13:12、4052 B、第 64 行有该调用。
#   结果：写在新版 rc.local 里的开机钩子在「已刷机的路由器」上从未执行，
#   /etc/openclash-credentials.txt 一直不存在（verify_flash.py 第 2 节报出的正是这一项）。
#   /etc/init.d/ 不在 keep.d 内，新文件必然随固件投放，故改由本脚本承担。
#
# 启用方式：/etc/uci-defaults/94-buffy-credentials.sh 在首启及每次升级后执行 enable。
#   （/etc/rc.d/ 同样不在 keep.d 内，sysupgrade 后 overlay 重建会丢掉软链，
#     必须靠 uci-defaults 重新建立；不能指望镜像里预置的 S99 软链。）
#
# 实际逻辑在 /usr/share/buffy/export_credentials.sh：幂等（内容未变不写、保持 mtime 稳定），
# 读不到任何凭据时返回 1 且不产出半截快照。

START=99

start() {
	/usr/share/buffy/export_credentials.sh >/dev/null 2>&1
}
