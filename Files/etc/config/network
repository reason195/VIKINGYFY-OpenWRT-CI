config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '00040f3ac6faa75a588a94b39ea76e7b7828'
	option packet_steering '0'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option ip6assign '64'
	option netmask '255.255.255.0'
	option ip6ifaceid 'eui64'

config interface 'wan'
	option device 'wan'
	option proto 'pppoe'
	option username '@@PPPOE_USERNAME@@'
	option password '@@PPPOE_PASSWORD@@'
	# '1' 只协商 IPv6CP；'auto' 会额外派生 wan_6 虚拟 dhcpv6 接口，与下方显式 wan6
	# 两个客户端同链路同 DUID 冲突，wan_6 每秒翻动刷爆日志（实测 15 分钟 1682 条）。
	option ipv6 '1'

config interface 'wan6'
	option device '@wan'
	option proto 'dhcpv6'
	option reqaddress 'try'
	option reqprefix 'auto'

config interface 'modem'
	option proto 'static'
	option device 'wan'
	option ipaddr '192.168.0.2'
	option netmask '255.255.255.0'
	option defaultroute '0'
	option peerdns '0'
