
config upnpd 'config'
	option enabled '1'
	option download '20480'
	option upload '2048'
	option internal_iface 'lan'
	option port '5000'
	option upnp_lease_file '/var/run/miniupnpd.leases'
	option upnp_lease_file6 '/var/run/miniupnpd.leases6'
	option igdv1 '1'
	option ipv6_disable '1'
	option use_stun '1'
	option stun_host 'stun.miwifi.com'
	option stun_port '3478'
	option ext_allow_private_ipv4 '1'
	option uuid '017ff610-a208-4d98-bcdf-0c36ba4c6307'

config perm_rule
	option action 'allow'
	option ext_ports '1024-65535'
	option int_addr '0.0.0.0/0'
	option int_ports '1024-65535'
	option comment 'Allow high ports'

config perm_rule
	option action 'deny'
	option ext_ports '0-65535'
	option int_addr '0.0.0.0/0'
	option int_ports '0-65535'
	option comment 'Default deny'

