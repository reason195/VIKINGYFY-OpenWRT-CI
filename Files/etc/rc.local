#!/bin/sh
# /etc/rc.local - 开机自启幂等检查（双保险）
# 即使 uci-defaults 因故未执行，也能在每次启动时确保关键配置就位。
# 使用标记文件避免重复写入，仅在配置缺失时修复。

exec >>/tmp/rc-local.log 2>&1

FLAG="/etc/.rc-local-done"

# 仅在首次（或重置后标记丢失）执行完整初始化
if [ ! -f "$FLAG" ]; then
  # 核心权限
  if [ -f /etc/openclash/core/clash_meta ]; then
    chmod +x /etc/openclash/core/clash_meta
  fi

  # OpenClash 配置指向
  if [ -f /etc/openclash/config/MihomoPro.yaml ]; then
    uci set openclash.config.config_path='/etc/openclash/config/MihomoPro.yaml' 2>/dev/null
    uci set openclash.config.enable='1' 2>/dev/null
    uci commit openclash 2>/dev/null
  fi

  # 标记已完成，避免每次启动重复执行
  touch "$FLAG"
fi

# 每次启动都确保核心可执行（轻量检查）
if [ -f /etc/openclash/core/clash_meta ]; then
  chmod +x /etc/openclash/core/clash_meta
fi

# syncdial fix: 确保 syncdial 配置文件存在，避免 ppp.sh 同步拨号时 uci 报错
[ -s /etc/config/syncdial ] || { printf 'config syncdial %s\n\toption enabled %s\n' 'config' '0' > /etc/config/syncdial; }

# dnsmasq 备用 DNS conf（/tmp 重启即清，每次启动重建；OpenClash 看门狗不管理此目录）
# 注意：uci show dhcp 对匿名 dnsmasq section 打印为 dhcp.@dnsmasq[0]=dnsmasq，没有 .type='dnsmasq' 行，
# 旧写法提取不到 cfgid 会把 conf 写到 /tmp/dnsmasq..d 导致备用上游从不生效。
# 改为与 OpenClash init 同法：从 dhcp.@dnsmasq[0] 取 cfgid，再读生成的 dnsmasq conf 里的 conf-dir=。
DEFAULT_DNSMASQ_CFGID=$(uci -q show 'dhcp.@dnsmasq[0]' | awk 'NR==1 {split($0, conf, /[.=]/); print conf[2]}')
DIR=""
[ -n "$DEFAULT_DNSMASQ_CFGID" ] && [ -f "/tmp/etc/dnsmasq.conf.$DEFAULT_DNSMASQ_CFGID" ] && \
	DIR=$(awk -F '=' '/^conf-dir=/ {print $2}' "/tmp/etc/dnsmasq.conf.$DEFAULT_DNSMASQ_CFGID")
# 兜底：从任意已生成的 dnsmasq conf 读取
[ -n "$DIR" ] || DIR=$(awk -F '=' '/^conf-dir=/ {print $2}' /tmp/etc/dnsmasq.conf.* 2>/dev/null | head -1)
[ -n "$DIR" ] || DIR="/tmp/dnsmasq.d"
mkdir -p "$DIR"
printf 'server=223.5.5.5\nserver=119.29.29.29\nserver=2400:3200::1\n' > "$DIR/60-fallback.conf"
chmod 644 "$DIR/60-fallback.conf"
/etc/init.d/dnsmasq restart >/dev/null 2>&1

# custom_fakeip_filter 自愈（防断网修复项）：订阅源/规则源/DDNS 等域名必须返回真实 IP。
# 若列表文件被误删、uci 标志被改回 0（本机无任何 OpenClash 操作会动它们，此为双保险），
# 每次启动时恢复。注意：列表烤在 /rom，这里直接从 /rom 恢复，避免内嵌第二份副本。
uci -q get openclash.config.custom_fakeip_filter | grep -q '^1$' || {
  uci set openclash.config.custom_fakeip_filter='1'
  uci commit openclash 2>/dev/null
}
[ -s /etc/openclash/custom/openclash_custom_fake_filter.list ] || {
  mkdir -p /etc/openclash/custom 2>/dev/null
  cp /rom/etc/openclash/custom/openclash_custom_fake_filter.list /etc/openclash/custom/openclash_custom_fake_filter.list 2>/dev/null
}
chmod 644 /etc/openclash/custom/openclash_custom_fake_filter.list 2>/dev/null

# Let's Encrypt 证书后台自愈（首次开机即尝试签发，缺失时由每日 cron 重试）
( sleep 90; /usr/share/buffy/cert_check.sh >/dev/null 2>&1 ) &

# 首次开机引导：等 OpenClash 启动完成、科学上网可用后，后台自动更新 GEO 数据库 / 大陆白名单 / Zashboard / Metacubexd
# （脚本自检标记 /etc/.openclash-bootstrap-done，仅首启执行；失败下次开机重试）
( sleep 30; /usr/share/buffy/first_boot_download.sh >/dev/null 2>&1 ) &

# 开机自检：等 OpenClash 核心 + 代理链路 204 确认；失败写日志/推 ntfy/Telegram 告警（防"看似启动实际未接管流量"）
# （脚本内部有 flock 防重入；每 boot 一次，成功只更新时间戳不打扰）
( sleep 120; /usr/share/buffy/boot_selfcheck.sh >/dev/null 2>&1 ) &

exit 0
